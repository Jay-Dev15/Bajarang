# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/bajarang
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bajarang?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bajarang

# Shared family PIN (4 to 8 digits). Changing it logs out every phone.
APP_PIN=change-me

# Long random secret used to sign login tokens (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string

# How many days a phone stays logged in after entering the PIN.
TOKEN_TTL_DAYS=60

# Frontend URL(s) allowed to call this API, comma separated.
CLIENT_ORIGIN=http://localhost:5173

PORT=5000
